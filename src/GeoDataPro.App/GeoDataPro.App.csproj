<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationTitle>GeoData Pro</ApplicationTitle>
    <AssemblyName>GeoDataPro</AssemblyName>
    <RootNamespace>GeoDataPro.App</RootNamespace>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\litho\**\*.png" />
    <Resource Include="Assets\texture\**\*.png" />
    <Resource Include="Assets\mineral\**\*.png" />
    <Resource Include="Assets\kern\**\*.png" />
  </ItemGroup>

</Project>
