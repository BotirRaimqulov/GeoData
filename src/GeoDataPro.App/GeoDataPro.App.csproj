<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationTitle>GeoData Pro</ApplicationTitle>
    <AssemblyName>GeoDataPro</AssemblyName>
    <RootNamespace>GeoDataPro.App</RootNamespace>
    <Version>1.0.0</Version>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GeoDataPro.Core\GeoDataPro.Core.csproj" />
    <ProjectReference Include="..\GeoDataPro.Platform.Windows\GeoDataPro.Platform.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\AppIcon.ico" />
    <Resource Include="Assets\AppLogo.png" />
    <Resource Include="Assets\litho\**\*.png" />
    <Resource Include="Assets\texture\**\*.png" />
    <Resource Include="Assets\mineral\**\*.png" />
    <Resource Include="Assets\kern\**\*.png" />
  </ItemGroup>

</Project>
