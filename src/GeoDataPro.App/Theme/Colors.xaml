<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Palette -->
    <Color x:Key="AccentColor">#2563EB</Color>
    <Color x:Key="AccentDarkColor">#1D4ED8</Color>
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentDark" Color="{StaticResource AccentDarkColor}" />
    <SolidColorBrush x:Key="AccentSoft" Color="#EEF3FF" />

    <SolidColorBrush x:Key="WindowBg" Color="#F4F5F7" />
    <SolidColorBrush x:Key="SidebarBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SidebarBorder" Color="#E4E7EC" />
    <SolidColorBrush x:Key="SidebarText" Color="#475467" />
    <SolidColorBrush x:Key="SidebarTextActive" Color="#1D4ED8" />
    <SolidColorBrush x:Key="SidebarIcon" Color="#98A2B3" />
    <SolidColorBrush x:Key="SidebarHeader" Color="#98A2B3" />
    <SolidColorBrush x:Key="SidebarHover" Color="#F2F4F7" />
    <SolidColorBrush x:Key="SidebarActiveBg" Color="#EEF3FF" />
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HeaderBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Border" Color="#E4E7EC" />
    <SolidColorBrush x:Key="BorderStrong" Color="#D0D5DD" />

    <SolidColorBrush x:Key="TextPrimary" Color="#1F2937" />
    <SolidColorBrush x:Key="TextSecondary" Color="#667085" />
    <SolidColorBrush x:Key="TextMuted" Color="#98A2B3" />

    <SolidColorBrush x:Key="RowHover" Color="#F5F8FF" />
    <SolidColorBrush x:Key="RowSelected" Color="#E3ECFF" />
    <SolidColorBrush x:Key="GridLine" Color="#EAECF0" />

    <SolidColorBrush x:Key="Success" Color="#16A34A" />
    <SolidColorBrush x:Key="Warn" Color="#D97706" />
    <SolidColorBrush x:Key="Danger" Color="#DC2626" />

    <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
    <sys:Double x:Key="RadiusSm">6</sys:Double>
    <CornerRadius x:Key="CardRadius">10</CornerRadius>
    <CornerRadius x:Key="CtlRadius">6</CornerRadius>

</ResourceDictionary>
