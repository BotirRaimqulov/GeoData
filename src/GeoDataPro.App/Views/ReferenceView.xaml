<UserControl x:Class="GeoDataPro.App.Views.ReferenceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:GeoDataPro.App.ViewModels"
             d:DataContext="{d:DesignInstance vm:ReferenceViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="+  Qo'shish" Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}" Margin="0,0,8,0" />
                    <Button Content="O'chirish" Style="{StaticResource GhostButton}" Command="{Binding DeleteCommand}" Margin="0,0,8,0" />
                    <Button Content="Saqlash" Style="{StaticResource GhostButton}" Command="{Binding SaveCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
            <Grid>
                <DataGrid ItemsSource="{Binding Litho}" SelectedItem="{Binding Selected}" BorderThickness="0"
                          Visibility="{Binding CurrentKind, Converter={StaticResource EnumVis}, ConverterParameter=Litho}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Kod" Binding="{Binding Code}" Width="60" />
                        <DataGridTextColumn Header="Nomi (o'zbekcha)" Binding="{Binding Name}" Width="2*" />
                        <DataGridTextColumn Header="Ruscha nomi" Binding="{Binding NameRu}" Width="2*" />
                        <DataGridTemplateColumn Header="Belgi" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource PreviewBox}">
                                            <Grid>
                                                <Image Stretch="Uniform"
                                                       Margin="4"
                                                       Source="{Binding PatternKey, Converter={StaticResource Pattern}, ConverterParameter=litho}"
                                                       Visibility="{Binding PatternKey, Converter={StaticResource NullToVis}}" />
                                                <TextBlock Text="∅"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextMuted}"
                                                           Visibility="{Binding PatternKey, Converter={StaticResource NotNullToVis}}" />
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{Binding PatternKey}" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Rang" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource InlineButton}" Click="PickColor_Click" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="24" Height="24" CornerRadius="6" Margin="0,0,8,0"
                                                    Background="{Binding HexColor, Converter={StaticResource HexBrush}}"
                                                    BorderBrush="{StaticResource Border}" BorderThickness="1" />
                                            <TextBlock Text="{Binding HexColor}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource InlineButton}" Click="PickColor_Click" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="24" Height="24" CornerRadius="6" Margin="0,0,8,0"
                                                    Background="{Binding HexColor, Converter={StaticResource HexBrush}}"
                                                    BorderBrush="{StaticResource Border}" BorderThickness="1" />
                                            <TextBlock Text="{Binding HexColor}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <DataGrid ItemsSource="{Binding Colors}" SelectedItem="{Binding Selected}" BorderThickness="0"
                          Visibility="{Binding CurrentKind, Converter={StaticResource EnumVis}, ConverterParameter=Color}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Kod" Binding="{Binding Code}" Width="60" />
                        <DataGridTextColumn Header="Nomi (o'zbekcha)" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Ruscha nomi" Binding="{Binding NameRu}" Width="*" />
                        <DataGridTemplateColumn Header="Rang" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource InlineButton}" Click="PickColor_Click" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="24" Height="24" CornerRadius="12" Margin="0,0,8,0"
                                                    Background="{Binding HexColor, Converter={StaticResource HexBrush}}"
                                                    BorderBrush="{StaticResource Border}" BorderThickness="1" />
                                            <TextBlock Text="{Binding HexColor}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource InlineButton}" Click="PickColor_Click" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="24" Height="24" CornerRadius="12" Margin="0,0,8,0"
                                                    Background="{Binding HexColor, Converter={StaticResource HexBrush}}"
                                                    BorderBrush="{StaticResource Border}" BorderThickness="1" />
                                            <TextBlock Text="{Binding HexColor}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <DataGrid ItemsSource="{Binding Textures}" SelectedItem="{Binding Selected}" BorderThickness="0"
                          Visibility="{Binding CurrentKind, Converter={StaticResource EnumVis}, ConverterParameter=Texture}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Kod" Binding="{Binding Code}" Width="60" />
                        <DataGridTextColumn Header="Nomi (o'zbekcha)" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Ruscha nomi" Binding="{Binding NameRu}" Width="*" />
                        <DataGridTemplateColumn Header="Preview" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource PreviewBox}">
                                            <Grid>
                                                <Image Stretch="Uniform"
                                                       Margin="4"
                                                       Source="{Binding PatternKey, Converter={StaticResource Pattern}, ConverterParameter=texture}"
                                                       Visibility="{Binding PatternKey, Converter={StaticResource NullToVis}}" />
                                                <TextBlock Text="∅"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextMuted}"
                                                           Visibility="{Binding PatternKey, Converter={StaticResource NotNullToVis}}" />
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{Binding PatternKey}" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <DataGrid ItemsSource="{Binding Minerals}" SelectedItem="{Binding Selected}" BorderThickness="0"
                          Visibility="{Binding CurrentKind, Converter={StaticResource EnumVis}, ConverterParameter=Mineral}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Kod" Binding="{Binding Code}" Width="60" />
                        <DataGridTemplateColumn Header="Nomi (o'zbekcha)" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Badge}"
                                            Background="{Binding Name, Converter={StaticResource PercentageBadgeBrush}}"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource BadgeText}"
                                                   Foreground="{Binding Name, Converter={StaticResource PercentageBadgeTextBrush}}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Ruscha nomi" Binding="{Binding NameRu}" Width="*" />
                        <DataGridTemplateColumn Header="Preview" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource PreviewBox}">
                                            <Grid>
                                                <Image Stretch="Uniform"
                                                       Margin="4"
                                                       Source="{Binding PatternKey, Converter={StaticResource Pattern}, ConverterParameter=mineral}"
                                                       Visibility="{Binding PatternKey, Converter={StaticResource NullToVis}}" />
                                                <TextBlock Text="∅"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextMuted}"
                                                           Visibility="{Binding PatternKey, Converter={StaticResource NotNullToVis}}" />
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{Binding PatternKey}" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <DataGrid x:Name="DescGrid" ItemsSource="{Binding Descriptions}" SelectedItem="{Binding Selected}" BorderThickness="0"
                          Visibility="{Binding CurrentKind, Converter={StaticResource EnumVis}, ConverterParameter=Description}"
                          PreparingCellForEdit="DescGrid_PreparingCellForEdit">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tavsif matni" Binding="{Binding Text}" Width="3*" MinWidth="260" />

                        <DataGridTemplateColumn Header="Litologik kod" Width="1.2*" MinWidth="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><TextBlock Text="{Binding LithoCode}" VerticalAlignment="Center" Margin="12,0" /></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.Ref.Litho, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              SelectedValue="{Binding LithoCode, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="Code" DisplayMemberPath="Name" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Rang" Width="1.1*" MinWidth="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><TextBlock Text="{Binding ColorCode}" VerticalAlignment="Center" Margin="12,0" /></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.Ref.Colors, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              SelectedValue="{Binding ColorCode, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="Code" DisplayMemberPath="Name" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Tekstura" Width="1.2*" MinWidth="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><TextBlock Text="{Binding TextureCode}" VerticalAlignment="Center" Margin="12,0" /></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.Ref.Textures, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              SelectedValue="{Binding TextureCode, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="Code" DisplayMemberPath="Name" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Mineral" Width="1.2*" MinWidth="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><TextBlock Text="{Binding MineralCode}" VerticalAlignment="Center" Margin="12,0" /></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.Ref.Minerals, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              SelectedValue="{Binding MineralCode, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="Code" DisplayMemberPath="Name" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Donadorligi" Width="1*" MinWidth="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><TextBlock Text="{Binding GrainSize}" VerticalAlignment="Center" Margin="12,0" /></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding GrainSize, UpdateSourceTrigger=PropertyChanged}">
                                        <ComboBoxItem Content="—" Tag="{x:Null}" />
                                        <ComboBoxItem Content="Mayda" Tag="mayda" />
                                        <ComboBoxItem Content="O'rta" Tag="o'rta" />
                                        <ComboBoxItem Content="Yirik" Tag="yirik" />
                                    </ComboBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
