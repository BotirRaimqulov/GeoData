<UserControl x:Class="GeoDataPro.App.Views.JournalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:GeoDataPro.App.ViewModels"
             xmlns:v="clr-namespace:GeoDataPro.App.Views"
             xmlns:inf="clr-namespace:GeoDataPro.App.Infrastructure"
             d:DataContext="{d:DesignInstance vm:MainViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <UserControl.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding Journal.SaveCommand}" />
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding Journal.AddRowCommand}" />
        <KeyBinding Key="D" Modifiers="Control" Command="{Binding Journal.DuplicateRowCommand}" />
        <KeyBinding Key="Delete" Command="{Binding Journal.DeleteRowCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Loyiha" Style="{StaticResource FieldLabel}" />
                        <ComboBox Width="220" ItemsSource="{Binding State.Projects}" DisplayMemberPath="Name"
                                  SelectedItem="{Binding State.CurrentProject}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Quduq" Style="{StaticResource FieldLabel}" />
                        <StackPanel Orientation="Horizontal">
                            <ComboBox Width="170" ItemsSource="{Binding State.CurrentWells}" DisplayMemberPath="Number"
                                      SelectedItem="{Binding State.CurrentWell}" />
                            <Button Content="+" Style="{StaticResource IconButton}" Margin="8,2,0,2"
                                    ToolTip="Yangi quduq qo'shish" Command="{Binding AddWellCommand}"
                                    IsEnabled="{Binding Journal.CanEdit}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Border Background="{StaticResource BadgeWarnBg}" Style="{StaticResource Badge}" Margin="0,0,8,0"
                            Visibility="{Binding Journal.HasUnsaved, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Saqlanmagan o'zgarishlar" Foreground="{StaticResource BadgeWarnText}" Style="{StaticResource BadgeText}" />
                    </Border>
                    <Button Content="⭱  Import Excel" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                            Command="{Binding ImportExcelCommand}" IsEnabled="{Binding CanImport}" />
                    <Button Content="⭳  Eksport" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                            Command="{Binding ExportExcelCommand}" IsEnabled="{Binding CanExport}" />
                    <Button Content="Saqlash (Ctrl+S)" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                            Command="{Binding Journal.SaveCommand}"
                            Visibility="{Binding Journal.HasUnsaved, Converter={StaticResource BoolToVis}}" />
                    <Button Content="+  Qator qo'shish" Style="{StaticResource PrimaryButton}"
                            Command="{Binding Journal.AddRowCommand}" IsEnabled="{Binding Journal.CanEdit}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Main split: grid + details ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="DetailsColumn" Width="320" MinWidth="240" MaxWidth="640" />
            </Grid.ColumnDefinitions>

            <GridSplitter Grid.Column="1" Style="{StaticResource PanelSplitter}" Margin="3,0" />

            <Grid Grid.Column="0" Margin="0,0,3,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                    <DataGrid x:Name="Grid" ItemsSource="{Binding Journal.Rows}"
                              SelectedItem="{Binding Journal.Selected}"
                              BorderThickness="0" CanUserSortColumns="False"
                              SelectionMode="Extended" SelectionUnit="FullRow"
                              inf:GridEditing.Enhanced="True"
                              ColumnHeaderStyle="{StaticResource WrapHeader}"
                              ColumnHeaderHeight="48"
                              CanUserResizeColumns="True" ColumnWidth="SizeToHeader"
                              FrozenColumnCount="3"
                              EnableColumnVirtualization="False"
                              HorizontalScrollBarVisibility="Visible"
                              VerticalScrollBarVisibility="Auto"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Visible"
                              PreviewMouseWheel="Grid_PreviewMouseWheel"
                              PreparingCellForEdit="Grid_PreparingCellForEdit">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№" Binding="{Binding OrderNo}" IsReadOnly="True" Width="58" MinWidth="52" />
                            <DataGridTextColumn Header="Yuqori (m)" EditingElementStyle="{StaticResource CellEditor}" Width="104" MinWidth="88"
                                                Binding="{Binding Top, Converter={StaticResource Num1}, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="Pastki (m)" EditingElementStyle="{StaticResource CellEditor}" Width="104" MinWidth="88"
                                                Binding="{Binding Bottom, Converter={StaticResource Num1}, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="Kern chiqishi (m)" EditingElementStyle="{StaticResource CellEditor}" Width="112" MinWidth="96"
                                                Binding="{Binding CoreRecoveryM, Converter={StaticResource Num1}, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="Kern chiqishi, %" Binding="{Binding RecoveryPercent, StringFormat={}{0:N1}%, Mode=OneWay}" IsReadOnly="True" Width="116" MinWidth="104" />
                            <DataGridTextColumn Header="Zona nomi" EditingElementStyle="{StaticResource CellEditor}" Width="130" MinWidth="110"
                                                Binding="{Binding ZoneName, UpdateSourceTrigger=PropertyChanged}" />

                            <DataGridTemplateColumn Header="Litologiya" Width="210" MinWidth="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="22" Height="16" CornerRadius="3" Margin="0,0,6,0"
                                                    Background="{Binding ColorHex, Converter={StaticResource HexBrush}}"
                                                    BorderBrush="{StaticResource Border}" BorderThickness="1">
                                                <Border.Visibility>
                                                    <Binding Path="LithoPattern" Converter="{StaticResource NotNullToVis}" />
                                                </Border.Visibility>
                                            </Border>
                                            <Image Width="26" Height="16" Margin="0,0,6,0" Stretch="Fill"
                                                   Source="{Binding LithoPattern, Converter={StaticResource Pattern}, ConverterParameter=litho}"
                                                   Visibility="{Binding LithoPattern, Converter={StaticResource NullToVis}}" />
                                            <TextBlock Text="{Binding LithoDisplay}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.Journal.Ref.Litho, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedValue="{Binding LithoCode, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectedValuePath="Code" IsEditable="True" IsTextSearchEnabled="True"
                                                  TextSearch.TextPath="Name" StaysOpenOnEdit="True"
                                                  GotKeyboardFocus="EditCombo_GotKeyboardFocus"
                                                  PreviewMouseLeftButtonDown="EditCombo_PreviewMouseLeftButtonDown">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Image Width="26" Height="16" Margin="0,0,8,0" Stretch="Fill"
                                                               Source="{Binding PatternKey, Converter={StaticResource Pattern}, ConverterParameter=litho}" />
                                                        <TextBlock Text="{Binding Code}" FontWeight="SemiBold" Width="28" />
                                                        <TextBlock Text="{Binding Name}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Rangi" Width="170" MinWidth="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="18" Height="18" CornerRadius="4" Margin="0,0,6,0"
                                                    Background="{Binding ColorHex, Converter={StaticResource HexBrush}}"
                                                    BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" />
                                            <TextBlock Text="{Binding ColorDisplay}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.Journal.Ref.Colors, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedValue="{Binding ColorCode, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectedValuePath="Code" IsEditable="True" IsTextSearchEnabled="True"
                                                  TextSearch.TextPath="Name" StaysOpenOnEdit="True"
                                                  GotKeyboardFocus="EditCombo_GotKeyboardFocus"
                                                  PreviewMouseLeftButtonDown="EditCombo_PreviewMouseLeftButtonDown">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Width="16" Height="16" CornerRadius="3" Margin="0,0,8,0"
                                                                Background="{Binding HexColor, Converter={StaticResource HexBrush}}"
                                                                BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" />
                                                        <TextBlock Text="{Binding Code}" FontWeight="SemiBold" Width="28" />
                                                        <TextBlock Text="{Binding Name}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Gidrookisleniya" Width="180" MinWidth="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding IronHydroxideDisplay}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.Journal.Ref.IronHydroxides, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedValue="{Binding IronHydroxideCode, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectedValuePath="Code" DisplayMemberPath="Name" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>



                            <DataGridTemplateColumn Header="Mineral tarkibi" Width="190" MinWidth="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding ClasticMaterialDisplay}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox IsEditable="True" IsReadOnly="True"
                                                  Text="{Binding ClasticMaterialDisplay, Mode=OneWay}"
                                                  ItemsSource="{Binding ClasticMaterialItems}">
                                            <ComboBox.ItemContainerStyle>
                                                <Style TargetType="ComboBoxItem">
                                                    <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ClasticComboItem_PreviewDown"/>
                                                </Style>
                                            </ComboBox.ItemContainerStyle>
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding Name}"
                                                              IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              IsHitTestVisible="False" Focusable="False" Margin="0,1"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Tekstura" Width="180" MinWidth="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding TextureDisplay}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.Journal.Ref.Textures, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedValue="{Binding TextureCode, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectedValuePath="Code" DisplayMemberPath="Name" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Donadorligi" Width="150" MinWidth="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding GrainSize}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedValuePath="Tag"
                                                  SelectedValue="{Binding GrainSize, UpdateSourceTrigger=PropertyChanged}">
                                            <ComboBoxItem Content="—" Tag="{x:Null}" />
                                            <ComboBoxItem Content="Mayda" Tag="mayda" />
                                            <ComboBoxItem Content="O'rta" Tag="o'rta" />
                                            <ComboBoxItem Content="Yirik" Tag="yirik" />
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Qattiqligi" Width="150" MinWidth="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Hardness}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedValuePath="Tag"
                                                  SelectedValue="{Binding Hardness, UpdateSourceTrigger=PropertyChanged}">
                                            <ComboBoxItem Content="—" Tag="{x:Null}" />
                                            <ComboBoxItem Content="Yumshoq" Tag="yumshoq" />
                                            <ComboBoxItem Content="O'rta" Tag="o'rta" />
                                            <ComboBoxItem Content="Qattiq" Tag="qattiq" />
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Sementlashuvi" Width="170" MinWidth="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Cementation}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedValuePath="Tag"
                                                  SelectedValue="{Binding Cementation, UpdateSourceTrigger=PropertyChanged}">
                                            <ComboBoxItem Content="—" Tag="{x:Null}" />
                                            <ComboBoxItem Content="Sementlashmagan" Tag="sementlashmagan" />
                                            <ComboBoxItem Content="Zaif sementlangan" Tag="zaif sementlangan" />
                                            <ComboBoxItem Content="O'rta sementlangan" Tag="o'rta sementlangan" />
                                            <ComboBoxItem Content="Kuchli sementlangan" Tag="kuchli sementlangan" />
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Mineralizatsiya" Width="190" MinWidth="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding MineralDisplay}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.Journal.Ref.Minerals, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedValue="{Binding MineralCode, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectedValuePath="Code" DisplayMemberPath="Name" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Flora-Fauna" Width="190" MinWidth="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding FloraFaunaDisplay}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.Journal.Ref.FloraFauna, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedValue="{Binding FloraFaunaCode, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectedValuePath="Code" DisplayMemberPath="Name" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Kern tavsifi" EditingElementStyle="{StaticResource CellEditor}" Width="340" MinWidth="220"
                                                Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Border Grid.Row="1" Background="{StaticResource WindowBg}" BorderBrush="{StaticResource Border}" BorderThickness="1,0,1,1"
                        CornerRadius="0,0,12,12" Padding="16,10" Margin="0,-1,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Jami qatorlar:" Foreground="{StaticResource TextSecondary}" />
                        <TextBlock Text="{Binding Journal.TotalRows}" FontWeight="SemiBold" Margin="6,0,0,0" />
                        <Border Background="{StaticResource BadgeInfoBg}" Style="{StaticResource Badge}" Margin="14,0,0,0"
                                Visibility="{Binding Journal.SelectedItems.Count, Converter={StaticResource IntToVis}}">
                            <TextBlock Text="{Binding Journal.SelectedItems.Count, StringFormat='Tanlangan: {0}'}" Foreground="{StaticResource BadgeInfoText}" Style="{StaticResource BadgeText}" />
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Right: details panel -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Text="Qator detallari" Style="{StaticResource H2}" Margin="0,0,0,14" />
                        <StackPanel DataContext="{Binding Journal.Selected}"
                                    Visibility="{Binding Converter={StaticResource NullToVis}}">
                            <TextBlock Text="YUQORI / PASTKI" Style="{StaticResource Caption}" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,14">
                                <TextBox Width="80" Text="{Binding Top, Converter={StaticResource Num1}, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="—" Margin="8,0" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" />
                                <TextBox Width="80" Text="{Binding Bottom, Converter={StaticResource Num1}, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="m" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" />
                            </StackPanel>

                            <TextBlock Text="INTERVAL" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding Interval, StringFormat={}{0:N1} m}" FontSize="15" FontWeight="SemiBold" Margin="0,2,0,14" />

                            <TextBlock Text="KERN CHIQISHI" Style="{StaticResource Caption}" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                <TextBox Width="80" Text="{Binding CoreRecoveryM, Converter={StaticResource Num1}, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="{Binding RecoveryText}" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" />
                            </StackPanel>
                            <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding RecoveryPercent, Mode=OneWay}"
                                         Foreground="{StaticResource Accent}" Background="{StaticResource GridLine}" Margin="0,0,0,14" />

                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="ZONA NOMI" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Border Background="{StaticResource BadgeInfoBg}" Style="{StaticResource Badge}" Margin="0,0,6,0"
                                            Visibility="{Binding ZoneNameIsAuto, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="avto" Foreground="{StaticResource BadgeInfoText}" Style="{StaticResource BadgeText}" />
                                    </Border>
                                    <Border Background="{StaticResource BadgeWarnBg}" Style="{StaticResource Badge}" Margin="0,0,6,0"
                                            Visibility="{Binding ZoneNameIsAuto, Converter={StaticResource InvBoolToVis}}">
                                        <TextBlock Text="qo'lda" Foreground="{StaticResource BadgeWarnText}" Style="{StaticResource BadgeText}" />
                                    </Border>
                                    <Button Content="↻ Avto" FontSize="11" Padding="7,3" Cursor="Hand"
                                            Command="{Binding DataContext.Journal.RegenerateZoneNameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            ToolTip="Zona nomini T/R (tartib raqami) ga qaytarish">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                <Setter Property="MinHeight" Value="0" />
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <TextBox Text="{Binding ZoneName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,14" />

                            <TextBlock Text="LITOLOGIK KOD" Style="{StaticResource Caption}" />
                            <ComboBox Margin="0,4,0,14"
                                      ItemsSource="{Binding DataContext.Journal.Ref.Litho, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      SelectedValue="{Binding LithoCode, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="Code" IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Name">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Width="26" Height="16" Margin="0,0,8,0" Stretch="Fill"
                                                   Source="{Binding PatternKey, Converter={StaticResource Pattern}, ConverterParameter=litho}" />
                                            <TextBlock Text="{Binding Code}" FontWeight="SemiBold" Width="28" />
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Text="RANGI" Style="{StaticResource Caption}" />
                            <ComboBox Margin="0,4,0,14"
                                      ItemsSource="{Binding DataContext.Journal.Ref.Colors, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      SelectedValue="{Binding ColorCode, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="Code" IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Name">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="16" Height="16" CornerRadius="3" Margin="0,0,8,0"
                                                    Background="{Binding HexColor, Converter={StaticResource HexBrush}}"
                                                    BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" />
                                            <TextBlock Text="{Binding Code}" FontWeight="SemiBold" Width="28" />
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Text="GIDROOKISLENIYA" Style="{StaticResource Caption}" />
                            <ComboBox Margin="0,4,0,14" DisplayMemberPath="Name"
                                      ItemsSource="{Binding DataContext.Journal.Ref.IronHydroxides, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      SelectedValue="{Binding IronHydroxideCode, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Code" />

                            <TextBlock Text="MINERAL TARKIBI" Style="{StaticResource Caption}" />
                            <ComboBox Margin="0,4,0,14" IsEditable="True" IsReadOnly="True"
                                      Text="{Binding ClasticMaterialDisplay, Mode=OneWay}"
                                      ItemsSource="{Binding ClasticMaterialItems}">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ClasticComboItem_PreviewDown"/>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}"
                                                  IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsHitTestVisible="False" Focusable="False" Margin="0,1"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Text="TEKSTURA" Style="{StaticResource Caption}" />
                            <ComboBox Margin="0,4,0,14" DisplayMemberPath="Name"
                                      ItemsSource="{Binding DataContext.Journal.Ref.Textures, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      SelectedValue="{Binding TextureCode, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Code" />

                            <TextBlock Text="DONADORLIGI" Style="{StaticResource Caption}" />
                            <ComboBox Margin="0,4,0,14" SelectedValuePath="Tag"
                                      SelectedValue="{Binding GrainSize, UpdateSourceTrigger=PropertyChanged}">
                                <ComboBoxItem Content="—" Tag="{x:Null}" />
                                <ComboBoxItem Content="Mayda" Tag="mayda" />
                                <ComboBoxItem Content="O'rta" Tag="o'rta" />
                                <ComboBoxItem Content="Yirik" Tag="yirik" />
                            </ComboBox>

                            <TextBlock Text="QATTIQLIGI" Style="{StaticResource Caption}" />
                            <ComboBox Margin="0,4,0,14" SelectedValuePath="Tag"
                                      SelectedValue="{Binding Hardness, UpdateSourceTrigger=PropertyChanged}">
                                <ComboBoxItem Content="—" Tag="{x:Null}" />
                                <ComboBoxItem Content="Yumshoq" Tag="yumshoq" />
                                <ComboBoxItem Content="O'rta" Tag="o'rta" />
                                <ComboBoxItem Content="Qattiq" Tag="qattiq" />
                            </ComboBox>

                            <TextBlock Text="SEMENTLASHUVI" Style="{StaticResource Caption}" />
                            <ComboBox Margin="0,4,0,14" SelectedValuePath="Tag"
                                      SelectedValue="{Binding Cementation, UpdateSourceTrigger=PropertyChanged}">
                                <ComboBoxItem Content="—" Tag="{x:Null}" />
                                <ComboBoxItem Content="Sementlashmagan" Tag="sementlashmagan" />
                                <ComboBoxItem Content="Zaif sementlangan" Tag="zaif sementlangan" />
                                <ComboBoxItem Content="O'rta sementlangan" Tag="o'rta sementlangan" />
                                <ComboBoxItem Content="Kuchli sementlangan" Tag="kuchli sementlangan" />
                            </ComboBox>

                            <TextBlock Text="MINERALIZATSIYA" Style="{StaticResource Caption}" />
                            <ComboBox Margin="0,4,0,14" DisplayMemberPath="Name"
                                      ItemsSource="{Binding DataContext.Journal.Ref.Minerals, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      SelectedValue="{Binding MineralCode, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Code" />

                            <TextBlock Text="FLORA-FAUNA" Style="{StaticResource Caption}" />
                            <ComboBox Margin="0,4,0,14" DisplayMemberPath="Name"
                                      ItemsSource="{Binding DataContext.Journal.Ref.FloraFauna, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      SelectedValue="{Binding FloraFaunaCode, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Code" />

                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="KERN TAVSIFI" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Border Background="{StaticResource BadgeInfoBg}" Style="{StaticResource Badge}" Margin="0,0,6,0"
                                            Visibility="{Binding DescriptionIsAuto, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="avto" Foreground="{StaticResource BadgeInfoText}" Style="{StaticResource BadgeText}" />
                                    </Border>
                                    <Border Background="{StaticResource BadgeWarnBg}" Style="{StaticResource Badge}" Margin="0,0,6,0"
                                            Visibility="{Binding DescriptionIsAuto, Converter={StaticResource InvBoolToVis}}">
                                        <TextBlock Text="qo'lda" Foreground="{StaticResource BadgeWarnText}" Style="{StaticResource BadgeText}" />
                                    </Border>
                                    <Button Content="↻ Avto" FontSize="11" Padding="7,3" Cursor="Hand"
                                            Command="{Binding DataContext.Journal.RegenerateDescriptionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            ToolTip="Eng mos tayyor shablondan (yoki litho/rang/tekstura/mineral/donadorlik nomlaridan) qayta yozish">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                <Setter Property="MinHeight" Value="0" />
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <v:AutocompleteBox x:Name="DescBox" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                               Suggestions="{Binding DataContext.Journal.DescriptionSuggestions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               Placeholder="Litho/rang tanlansa avtomatik to'ladi — Tab bilan to'ldirish"
                                               MinHeight="72" Padding="11,8" />
                            <TextBlock Text="Tab / → — taklifni to'ldirish · ↑ ↓ Enter — ro'yxatdan tanlash · so'zni ikki marta bosib tanlasangiz — muqobil variantlar chiqadi" FontSize="10"
                                       Foreground="{StaticResource TextMuted}" Margin="2,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBlock Text="Qator tanlanmagan" Foreground="{StaticResource TextMuted}" Margin="0,20"
                                   Visibility="{Binding Journal.Selected, Converter={StaticResource NotNullToVis}}" />

                        <Separator Margin="0,18" Background="{StaticResource Border}" />

                        <TextBlock Text="Tezkor amallar" Style="{StaticResource H2}" FontSize="13" Margin="0,0,0,10" />
                        <Button Content="⧉  Qatorni nusxalash  (Ctrl+D)" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left"
                                Margin="0,0,0,6" Command="{Binding Journal.DuplicateRowCommand}" IsEnabled="{Binding Journal.CanEdit}" />
                        <Button Content="↑  Yuqoriga surish" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left"
                                Margin="0,0,0,6" Command="{Binding Journal.MoveUpCommand}" />
                        <Button Content="↓  Pastga surish" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left"
                                Margin="0,0,0,6" Command="{Binding Journal.MoveDownCommand}" />
                        <Button Content="🗑  Qatorni o'chirish  (Del)" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left"
                                Command="{Binding Journal.DeleteRowCommand}" IsEnabled="{Binding Journal.CanEdit}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>