<Window x:Class="GeoDataPro.App.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:GeoDataPro.App.Views"
        Title="Parolni o'zgartirish" Height="600" Width="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        MouseLeftButtonDown="Window_Drag">

    <Grid Margin="26">
        <Border CornerRadius="20" BorderBrush="#D9E2EF" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="38" ShadowDepth="7" Opacity="0.20" Color="#1F2937" />
            </Border.Effect>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FBFDFF" Offset="0" />
                    <GradientStop Color="#EEF3FA" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="28,20,16,0">
                    <TextBlock Text="GeoData Pro" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                    <Button HorizontalAlignment="Right" Width="30" Height="30" Click="Close_Click"
                            Cursor="Hand" Focusable="False" ToolTip="Yopish">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" CornerRadius="8" Background="Transparent">
                                    <Path Width="11" Height="11" Stretch="Uniform" Fill="{StaticResource TextMuted}"
                                          Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="#E7EDF6" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="40,18,40,30">
                        <TextBlock Text="Parolni o'zgartirish" FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8" />
                        <TextBlock Text="Yangi parolni kiriting va tasdiqlang" FontSize="14"
                                   Foreground="{StaticResource TextSecondary}" Margin="0,0,0,24" />

                        <v:SecretField x:Name="CurrentField" Label="Joriy parol" Margin="0,0,0,18"
                                       Icon="M12,17A2,2 0 0,0 14,15C14,13.89 13.1,13 12,13A2,2 0 0,0 10,15A2,2 0 0,0 12,17M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V10C4,8.89 4.9,8 6,8H7V6A5,5 0 0,1 12,1A5,5 0 0,1 17,6V8H18M12,3A3,3 0 0,0 9,6V8H15V6A3,3 0 0,0 12,3Z" />

                        <v:SecretField x:Name="NewField" Label="Yangi parol" Margin="0,0,0,18"
                                       Icon="M7,14A2,2 0 0,1 5,12A2,2 0 0,1 7,10A2,2 0 0,1 9,12A2,2 0 0,1 7,14M12.65,10C11.83,7.67 9.61,6 7,6A6,6 0 0,0 1,12A6,6 0 0,0 7,18C9.61,18 11.83,16.33 12.65,14H17V18H21V14H23V10H12.65Z" />

                        <v:SecretField x:Name="ConfirmField" Label="Yangi parolni takrorlang" Margin="0,0,0,14"
                                       Icon="M7,14A2,2 0 0,1 5,12A2,2 0 0,1 7,10A2,2 0 0,1 9,12A2,2 0 0,1 7,14M12.65,10C11.83,7.67 9.61,6 7,6A6,6 0 0,0 1,12A6,6 0 0,0 7,18C9.61,18 11.83,16.33 12.65,14H17V18H21V14H23V10H12.65Z" />

                        <TextBlock Text="Kamida 12 belgi: Harf, raqam va maxsus belgi" FontSize="13"
                                   TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}"
                                   Margin="2,0,0,14" />

                        <TextBlock x:Name="MessageText" FontSize="13" TextWrapping="Wrap" MinHeight="34"
                                   Foreground="{StaticResource TextSecondary}" Margin="2,0,0,18" />

                        <Button x:Name="SubmitButton" Content="Saqlash" Height="50" Click="OnSubmit" IsDefault="True"
                                Cursor="Hand" Foreground="White" FontSize="15" FontWeight="SemiBold">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" CornerRadius="12" Background="{StaticResource Accent}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentDark}" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Bg" Property="Opacity" Value="0.55" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
