<Window x:Class="GeoDataPro.App.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Parolni o'zgartirish" Height="400" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBg}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Border Padding="28,24">
        <StackPanel>
            <TextBlock Text="Parolni o'zgartirish" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,18" />

            <TextBlock Text="Joriy parol" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5" />
            <PasswordBox x:Name="CurrentBox" MaxLength="256" Margin="0,0,0,14" />

            <TextBlock Text="Yangi parol" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5" />
            <PasswordBox x:Name="NewBox" MaxLength="256" Margin="0,0,0,14" />

            <TextBlock Text="Yangi parolni takrorlang" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5" />
            <PasswordBox x:Name="ConfirmBox" MaxLength="256" Margin="0,0,0,10" />

            <TextBlock Text="Kamida 12 belgi, harf, raqam va belgilar aralashmasi."
                       TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,10" />

            <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="11" MinHeight="32"
                       Foreground="{StaticResource TextSecondary}" Margin="0,0,0,12" />

            <Button x:Name="SubmitButton" Content="Saqlash" Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Stretch" Height="36" Click="OnSubmit" IsDefault="True" />
        </StackPanel>
    </Border>
</Window>
