<UserControl x:Class="GeoDataPro.App.Views.WellsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:GeoDataPro.App.Views">
    <Grid Margin="24,20" DataContext="{Binding Wells}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,16">
            <v:StatTile Caption="Jami loyihalar" Value="{Binding ProjectCount}" Unit="ta" />
            <v:StatTile Caption="Jami quduqlar" Value="{Binding WellCount}" Unit="ta" />
            <v:StatTile Caption="Jurnal qatorlari" Value="{Binding TotalJournalCount}" Unit="ta" />
            <v:StatTile Caption="Namunalar" Value="{Binding TotalSampleCount}" Unit="ta" />
        </StackPanel>

        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,0" Padding="0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="16,16,16,12">
                    <TextBlock Text="Loyihalar" Style="{StaticResource H2}" VerticalAlignment="Center" />
                    <Button Content="+" Style="{StaticResource IconButton}" HorizontalAlignment="Right"
                            Command="{Binding AddProjectCommand}" />
                </Grid>
                <ListBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" DisplayMemberPath="Name" />
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,16,0" Padding="0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="16,16,16,12">
                    <TextBlock Text="Loyiha va quduqlar ro'yxati" Style="{StaticResource H2}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="+  Quduq" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                                Command="{Binding AddWellCommand}" />
                        <Button Content="O'chirish" Style="{StaticResource GhostButton}"
                                Command="{Binding DeleteWellCommand}" />
                    </StackPanel>
                </Grid>
                <DataGrid ItemsSource="{Binding Wells}" SelectedItem="{Binding SelectedWell}" BorderThickness="0" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Quduq" Binding="{Binding Number}" Width="110" />
                        <DataGridTextColumn Header="Boshlanish" Binding="{Binding StartDepth, StringFormat={}{0:0.#}}" Width="110" />
                        <DataGridTextColumn Header="Tugash" Binding="{Binding EndDepth, StringFormat={}{0:0.#}}" Width="110" />
                        <DataGridTextColumn Header="Jurnal" Binding="{Binding JournalCount}" Width="90" />
                        <DataGridTextColumn Header="Namuna" Binding="{Binding SampleCount}" Width="90" />
                        <DataGridTextColumn Header="Geolog" Binding="{Binding Geologist}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}">
            <StackPanel DataContext="{Binding SelectedWell}">
                <TextBlock Text="Quduq ma'lumotlari" Style="{StaticResource H2}" Margin="0,0,0,16" />
                <StackPanel Visibility="{Binding Converter={StaticResource NullToVis}}">
                    <TextBlock Text="QUDUQ RAQAMI" Style="{StaticResource Caption}" />
                    <TextBox Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,14" />
                    <TextBlock Text="BURG'ILASH USK №" Style="{StaticResource Caption}" />
                    <TextBox Text="{Binding RigNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,14" />
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="BOSHLANISH (m)" Style="{StaticResource Caption}" />
                            <TextBox Text="{Binding StartDepth, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="TUGASH (m)" Style="{StaticResource Caption}" />
                            <TextBox Text="{Binding EndDepth, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="BURG'ILASH BOSHLANDI" Style="{StaticResource Caption}" />
                    <TextBox Text="{Binding StartDate, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,14" />
                    <TextBlock Text="BURG'ILASH TUGADI" Style="{StaticResource Caption}" />
                    <TextBox Text="{Binding EndDate, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,14" />
                    <TextBlock Text="GEOLOG" Style="{StaticResource Caption}" />
                    <TextBox Text="{Binding Geologist, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,18" />
                    <Button Content="Saqlash" Style="{StaticResource PrimaryButton}"
                            Command="{Binding DataContext.SaveWellCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </StackPanel>
                <TextBlock Text="Quduq tanlanmagan" Foreground="{StaticResource TextMuted}"
                           Visibility="{Binding Converter={StaticResource NotNullToVis}}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
