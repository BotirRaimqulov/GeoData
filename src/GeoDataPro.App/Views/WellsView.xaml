<UserControl x:Class="GeoDataPro.App.Views.WellsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,20" DataContext="{Binding Wells}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <!-- Projects -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,0" Padding="0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="14,12">
                    <TextBlock Text="Loyihalar" Style="{StaticResource H2}" VerticalAlignment="Center" />
                    <Button Content="+" Style="{StaticResource GhostButton}" Padding="10,3" HorizontalAlignment="Right"
                            Command="{Binding AddProjectCommand}" />
                </Grid>
                <ListBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}"
                         BorderThickness="0" DisplayMemberPath="Name" />
            </DockPanel>
        </Border>

        <!-- Wells list -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,16,0" Padding="0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="14,12">
                    <TextBlock Text="Quduqlar" Style="{StaticResource H2}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="+  Quduq" Style="{StaticResource GhostButton}" Padding="10,3" Margin="0,0,6,0"
                                Command="{Binding AddWellCommand}" />
                        <Button Content="🗑" Style="{StaticResource GhostButton}" Padding="10,3"
                                Command="{Binding DeleteWellCommand}" />
                    </StackPanel>
                </Grid>
                <DataGrid ItemsSource="{Binding Wells}" SelectedItem="{Binding SelectedWell}" BorderThickness="0" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Raqami" Binding="{Binding Number}" Width="100" />
                        <DataGridTextColumn Header="Chuqurlik" Binding="{Binding StartDepth, StringFormat={}{0:0.#}}" Width="90" />
                        <DataGridTextColumn Header="Tugash" Binding="{Binding EndDepth, StringFormat={}{0:0.#}}" Width="90" />
                        <DataGridTextColumn Header="Jurnal" Binding="{Binding JournalCount}" Width="80" />
                        <DataGridTextColumn Header="Namuna" Binding="{Binding SampleCount}" Width="80" />
                        <DataGridTextColumn Header="Geolog" Binding="{Binding Geologist}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- Well editor -->
        <Border Grid.Column="2" Style="{StaticResource Card}">
            <StackPanel DataContext="{Binding SelectedWell}">
                <TextBlock Text="Quduq ma'lumotlari" Style="{StaticResource H2}" Margin="0,0,0,14" />
                <StackPanel Visibility="{Binding Converter={StaticResource NullToVis}}">
                    <TextBlock Text="QUDUQ RAQAMI" Style="{StaticResource Caption}" />
                    <TextBox Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" />
                    <TextBlock Text="BURG'ILASH USK №" Style="{StaticResource Caption}" />
                    <TextBox Text="{Binding RigNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="BOSHLANISH (m)" Style="{StaticResource Caption}" />
                            <TextBox Text="{Binding StartDepth, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="TUGASH (m)" Style="{StaticResource Caption}" />
                            <TextBox Text="{Binding EndDepth, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="BURG'ILASH BOSHLANDI" Style="{StaticResource Caption}" />
                    <TextBox Text="{Binding StartDate, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" />
                    <TextBlock Text="BURG'ILASH TUGADI" Style="{StaticResource Caption}" />
                    <TextBox Text="{Binding EndDate, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" />
                    <TextBlock Text="GEOLOG" Style="{StaticResource Caption}" />
                    <TextBox Text="{Binding Geologist, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,16" />
                    <Button Content="Saqlash" Style="{StaticResource PrimaryButton}"
                            Command="{Binding DataContext.SaveWellCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </StackPanel>
                <TextBlock Text="Quduq tanlanmagan" Foreground="{StaticResource TextMuted}"
                           Visibility="{Binding Converter={StaticResource NotNullToVis}}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
