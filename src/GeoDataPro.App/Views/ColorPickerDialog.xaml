<Window x:Class="GeoDataPro.App.Views.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rang tanlash"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBg}">
    <Border Style="{StaticResource Card}" Margin="16">
        <StackPanel>
            <TextBlock Text="Rang tanlash" Style="{StaticResource H2}" Margin="0,0,0,16" />
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="PreviewSwatch"
                        Width="96"
                        Height="96"
                        CornerRadius="16"
                        BorderBrush="{StaticResource Border}"
                        BorderThickness="1" />
                <StackPanel Grid.Column="2">
                    <TextBlock Text="HEX" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="HexBox" Margin="0,4,0,0" TextChanged="HexBox_TextChanged" />
                </StackPanel>
            </Grid>
            <TextBlock Text="Qizil" Style="{StaticResource FieldLabel}" />
            <Slider x:Name="RedSlider" Minimum="0" Maximum="255" ValueChanged="Slider_ValueChanged" Margin="0,2,0,14" />
            <TextBlock Text="Yashil" Style="{StaticResource FieldLabel}" />
            <Slider x:Name="GreenSlider" Minimum="0" Maximum="255" ValueChanged="Slider_ValueChanged" Margin="0,2,0,14" />
            <TextBlock Text="Ko'k" Style="{StaticResource FieldLabel}" />
            <Slider x:Name="BlueSlider" Minimum="0" Maximum="255" ValueChanged="Slider_ValueChanged" Margin="0,2,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Bekor qilish" Style="{StaticResource GhostButton}" Width="120" Margin="0,0,8,0" Click="Cancel_Click" />
                <Button Content="Qo'llash" Style="{StaticResource PrimaryButton}" Width="120" Click="Ok_Click" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
