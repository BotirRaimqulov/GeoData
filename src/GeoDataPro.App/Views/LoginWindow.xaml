<Window x:Class="GeoDataPro.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:GeoDataPro.App.Views"
        Title="GeoData Pro" Height="720" Width="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="True"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        MouseLeftButtonDown="Window_Drag">

    <Grid Margin="30">
        <Border CornerRadius="22" Background="#F4F7FB" BorderBrush="#D9E2EF" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="42" ShadowDepth="8" Opacity="0.20" Color="#1F2937" />
            </Border.Effect>

            <Border CornerRadius="22">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FBFDFF" Offset="0" />
                        <GradientStop Color="#EEF3FA" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Loading overlay: shown after successful auth while MainWindow initialises -->
                    <Grid x:Name="LoadingOverlay" Grid.RowSpan="2" Visibility="Collapsed"
                          Background="#CCF4F7FB" Panel.ZIndex="99">
                        <Border Width="220" Height="130" CornerRadius="16"
                                Background="White" BorderBrush="#D9E2EF" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.14" Color="#1F2937"/>
                            </Border.Effect>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Ellipse x:Name="SpinnerRing" Width="36" Height="36"
                                         Stroke="{StaticResource Accent}" StrokeThickness="3.5"
                                         StrokeDashArray="6 3" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform x:Name="SpinnerAngle" Angle="0"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <TextBlock x:Name="OverlayText" Text="Yuklanmoqda..."
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"
                                           HorizontalAlignment="Center" Margin="0,14,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="0" Margin="30,24,20,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource Accent}"
                                    Margin="0,0,12,0">
                                <Image Source="pack://application:,,,/Assets/AppLogo.png" Width="22" Height="22" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <TextBlock Text="GeoData Pro" FontSize="19" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                        </StackPanel>

                        <Button x:Name="CloseButton" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Width="32" Height="32" Click="Close_Click" Cursor="Hand"
                                ToolTip="Yopish" Focusable="False">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" CornerRadius="8" Background="Transparent">
                                        <Path Width="12" Height="12" Stretch="Uniform"
                                              Fill="{StaticResource TextMuted}"
                                              Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#E7EDF6" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0">
                        <StackPanel Margin="46,26,46,34">
                            <TextBlock x:Name="HeadingText" FontSize="30" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap"
                                       Margin="0,0,0,8" />
                            <TextBlock x:Name="SubheadingText" FontSize="14"
                                       Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"
                                       Margin="0,0,0,26" />

                            <v:SecretField x:Name="UserField" Label="Foydalanuvchi" Masked="False" Margin="0,0,0,18"
                                           Icon="M12,12A5,5 0 0,0 17,7A5,5 0 0,0 12,2A5,5 0 0,0 7,7A5,5 0 0,0 12,12M12,14.5C8.67,14.5 2,16.17 2,19.5V22H22V19.5C22,16.17 15.33,14.5 12,14.5Z" />

                            <v:SecretField x:Name="PassField" Label="Parol" Margin="0,0,0,18"
                                           Icon="M12,17A2,2 0 0,0 14,15C14,13.89 13.1,13 12,13A2,2 0 0,0 10,15A2,2 0 0,0 12,17M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V10C4,8.89 4.9,8 6,8H7V6A5,5 0 0,1 12,1A5,5 0 0,1 17,6V8H18M12,3A3,3 0 0,0 9,6V8H15V6A3,3 0 0,0 12,3Z" />

                            <v:SecretField x:Name="ConfirmField" Label="Parolni takrorlang" Margin="0,0,0,14"
                                           Visibility="Collapsed"
                                           Icon="M7,14A2,2 0 0,1 5,12A2,2 0 0,1 7,10A2,2 0 0,1 9,12A2,2 0 0,1 7,14M12.65,10C11.83,7.67 9.61,6 7,6A6,6 0 0,0 1,12A6,6 0 0,0 7,18C9.61,18 11.83,16.33 12.65,14H17V18H21V14H23V10H12.65Z" />

                            <TextBlock x:Name="HintText" FontSize="13" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondary}"
                                       Text="Kamida 12 belgi: Harf, raqam va maxsus belgi"
                                       Visibility="Collapsed" Margin="2,0,0,14" />

                            <TextBlock x:Name="MessageText" FontSize="13" TextWrapping="Wrap" MinHeight="38"
                                       Foreground="{StaticResource TextSecondary}" Margin="2,0,0,18" />

                            <Button x:Name="SubmitButton" Height="52" Click="OnSubmit" IsDefault="True"
                                    Cursor="Hand" Foreground="White" FontSize="16" FontWeight="SemiBold">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bg" CornerRadius="12" Background="{StaticResource Accent}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentDark}" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Bg" Property="Opacity" Value="0.55" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
