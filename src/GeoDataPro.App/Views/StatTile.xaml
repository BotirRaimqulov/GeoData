<UserControl x:Class="GeoDataPro.App.Views.StatTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border Padding="14,12" Margin="0,0,10,0" Background="#FBFCFE"
            BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" MinWidth="120">
        <StackPanel>
            <TextBlock Text="{Binding Caption, ElementName=Root}" Style="{StaticResource Caption}" />
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="{Binding Value, ElementName=Root}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                <TextBlock Text="{Binding Unit, ElementName=Root}" FontSize="12" Foreground="{StaticResource TextMuted}"
                           VerticalAlignment="Bottom" Margin="4,0,0,4" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
