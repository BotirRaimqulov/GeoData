<UserControl x:Class="GeoDataPro.App.Views.SamplesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inf="clr-namespace:GeoDataPro.App.Infrastructure">
    <Grid Margin="24,20" DataContext="{Binding Samples}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Loyiha" Style="{StaticResource FieldLabel}" />
                        <ComboBox Width="220" DisplayMemberPath="Name"
                                  ItemsSource="{Binding DataContext.State.Projects, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  SelectedItem="{Binding DataContext.State.CurrentProject, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Quduq" Style="{StaticResource FieldLabel}" />
                        <StackPanel Orientation="Horizontal">
                            <ComboBox Width="170" DisplayMemberPath="Number"
                                      ItemsSource="{Binding DataContext.State.CurrentWells, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      SelectedItem="{Binding DataContext.State.CurrentWell, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            <Button Content="+" Style="{StaticResource IconButton}" Margin="8,2,0,2"
                                    ToolTip="Yangi quduq qo'shish"
                                    Command="{Binding DataContext.AddWellCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="20,0,16,0">
                    <TextBlock Text="Namuna turi" Style="{StaticResource FieldLabel}" />
                    <ComboBox Width="250"
                              ItemsSource="{Binding SampleTypes}"
                              SelectedValuePath="Code"
                              DisplayMemberPath="Name"
                              SelectedValue="{Binding SelectedSampleTypeCode, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Border Background="{StaticResource BadgeInfoBg}" Style="{StaticResource Badge}" Margin="0,0,8,0"
                            Visibility="{Binding SelectedItems.Count, Converter={StaticResource IntToVis}}">
                        <TextBlock Text="{Binding SelectedItems.Count, StringFormat='Tanlangan: {0}'}" Foreground="{StaticResource BadgeInfoText}" Style="{StaticResource BadgeText}" />
                    </Border>
                    <Border Background="{StaticResource BadgeWarnBg}" Style="{StaticResource Badge}" Margin="0,0,8,0"
                            Visibility="{Binding HasUnsaved, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Saqlanmagan o'zgarishlar" Foreground="{StaticResource BadgeWarnText}" Style="{StaticResource BadgeText}" />
                    </Border>
                    <Button Content="+  Namuna qo'shish" Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}" Margin="0,0,8,0"  IsEnabled="{Binding CanEdit}" />
                    <Button Content="O'chirish" Style="{StaticResource GhostButton}" Command="{Binding DeleteCommand}" Margin="0,0,8,0"  IsEnabled="{Binding CanEdit}" />
                    <Button Content="Saqlash" Style="{StaticResource GhostButton}" Command="{Binding SaveCommand}"  IsEnabled="{Binding CanEdit}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
            <DataGrid x:Name="Grid" ItemsSource="{Binding FilteredRows}" SelectedItem="{Binding Selected}"
                      SelectionMode="Extended" SelectionUnit="FullRow" BorderThickness="0"
                      inf:GridEditing.Enhanced="True"
                      ColumnHeaderStyle="{StaticResource WrapHeader}"
                      CanUserSortColumns="False"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      SelectionChanged="Grid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tartib raqam" Binding="{Binding DisplayOrder}" IsReadOnly="True" Width="1*" MinWidth="100" />
                    <DataGridTextColumn Header="Namuna raqami" Binding="{Binding SampleNumber, UpdateSourceTrigger=PropertyChanged}" Width="1.4*" MinWidth="140"
                                        EditingElementStyle="{StaticResource CellEditor}" />
                    <DataGridTextColumn Header="Namuna turi kodi" Width="1.2*" MinWidth="120" EditingElementStyle="{StaticResource CellEditor}"
                                        Binding="{Binding SampleTypeCode, Converter={StaticResource Num3}, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTextColumn Header="Yuqori (m)" Width="1*" MinWidth="100" EditingElementStyle="{StaticResource CellEditor}"
                                        Binding="{Binding Top, Converter={StaticResource Num1}, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTextColumn Header="Pastki (m)" Width="1*" MinWidth="100" EditingElementStyle="{StaticResource CellEditor}"
                                        Binding="{Binding Bottom, Converter={StaticResource Num1}, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTextColumn Header="Uzunlik (m)" Binding="{Binding Length, StringFormat=N1}" IsReadOnly="True" Width="1*" MinWidth="100" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>