<UserControl x:Class="GeoDataPro.App.Views.SamplesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:GeoDataPro.App.Views">
    <Grid Margin="24,20" DataContext="{Binding Samples}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <Button Content="+  Namuna qo'shish" Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}" Margin="0,0,8,0" />
            <Button Content="🗑  O'chirish" Style="{StaticResource GhostButton}" Command="{Binding DeleteCommand}" Margin="0,0,8,0" />
            <Button Content="Saqlash" Style="{StaticResource GhostButton}" Command="{Binding SaveCommand}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Namuna raqami" Binding="{Binding SampleNumber, UpdateSourceTrigger=PropertyChanged}" Width="160" />
                    <DataGridTextColumn Header="TOP (m)" Binding="{Binding Top, StringFormat=N1, UpdateSourceTrigger=PropertyChanged}" Width="120" />
                    <DataGridTextColumn Header="BOTTOM (m)" Binding="{Binding Bottom, StringFormat=N1, UpdateSourceTrigger=PropertyChanged}" Width="120" />
                    <DataGridTextColumn Header="Uzunlik (m)" Binding="{Binding Length, StringFormat=N1}" IsReadOnly="True" Width="120" />
                    <DataGridTextColumn Header="Zona" Binding="{Binding ZoneName, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                    <DataGridTextColumn Header="Izoh" Binding="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,0">
            <v:StatTile Caption="Jami namunalar" Value="{Binding Count}" Unit="ta" />
            <v:StatTile Caption="Umumiy uzunlik" Value="{Binding TotalLength}" Unit="m" />
        </StackPanel>
    </Grid>
</UserControl>
