<Window x:Class="GeoDataPro.App.Views.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GeoData Pro" SizeToContent="Height" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource CardBg}">
    <StackPanel Margin="20">
        <TextBlock x:Name="PromptText" Style="{StaticResource FieldLabel}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,10" />
        <TextBox x:Name="Input" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Bekor" Style="{StaticResource GhostButton}" Width="90" Click="Cancel_Click" Margin="0,0,8,0" />
            <Button Content="OK" Style="{StaticResource PrimaryButton}" Width="90" Click="Ok_Click" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
