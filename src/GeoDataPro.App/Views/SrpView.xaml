<UserControl x:Class="GeoDataPro.App.Views.SrpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:GeoDataPro.App.Views">
    <Grid Margin="24,20" DataContext="{Binding Srp}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Loyiha" Style="{StaticResource FieldLabel}" />
                            <ComboBox Width="220" DisplayMemberPath="Name"
                                      ItemsSource="{Binding DataContext.State.Projects, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      SelectedItem="{Binding DataContext.State.CurrentProject, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Quduq" Style="{StaticResource FieldLabel}" />
                            <StackPanel Orientation="Horizontal">
                                <ComboBox Width="170" DisplayMemberPath="Number"
                                          ItemsSource="{Binding DataContext.State.CurrentWells, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SelectedItem="{Binding DataContext.State.CurrentWell, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                <Button Content="+" Style="{StaticResource IconButton}" Margin="8,2,0,2"
                                        ToolTip="Yangi quduq qo'shish"
                                        Command="{Binding DataContext.AddWellCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Content="+  Nuqta qo'shish" Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}" Margin="0,0,8,0" />
                        <Button Content="O'chirish" Style="{StaticResource GhostButton}" Command="{Binding DeleteCommand}" Margin="0,0,8,0" />
                        <Button Content="Saqlash" Style="{StaticResource GhostButton}" Command="{Binding SaveCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="MD (m)" Binding="{Binding Md, StringFormat=N1, UpdateSourceTrigger=PropertyChanged}" Width="1*" MinWidth="120" />
                        <DataGridTextColumn Header="Core_GK" Binding="{Binding CoreGk, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}" Width="1*" MinWidth="140" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <Border Grid.Column="1" Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Kern GK karotaj chizig'i" Style="{StaticResource H2}" Margin="0,0,0,12" />
                <ItemsControl ItemsSource="{Binding Chart}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas Background="{StaticResource WindowBg}" ClipToBounds="True" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left">
                                <Setter.Value>
                                    <MultiBinding>
                                        <MultiBinding.Converter>
                                            <v:CanvasScaleConverter Axis="X" Padding="20" />
                                        </MultiBinding.Converter>
                                        <Binding Path="NormX" />
                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                    </MultiBinding>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Canvas.Top">
                                <Setter.Value>
                                    <MultiBinding>
                                        <MultiBinding.Converter>
                                            <v:CanvasScaleConverter Axis="Y" Padding="12" />
                                        </MultiBinding.Converter>
                                        <Binding Path="NormY" />
                                        <Binding Path="ActualHeight" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                    </MultiBinding>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Ellipse Width="6" Height="6" Fill="{StaticResource Accent}" ToolTip="{Binding Value}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
